generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String         @id @default(cuid())
  username                String         @unique
  email                   String         @unique
  password                String
  continent               Continent
  countryCode             String
  totalPositionsPurchased Int            @default(0)
  currentContinentRank    Int            @default(0)
  currentGlobalRank       Int            @default(0)
  role                    Role           @default(USER)
  resetToken              String?
  resetTokenExpiry        DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  notifications           Notification[]
  transactions            Transaction[]
  rankEventsAsClimber     RankEvent[]    @relation("RankEventsAsClimber")
  rankEventsAsAffected    RankEvent[]    @relation("RankEventsAsAffected")

  @@index([continent, totalPositionsPurchased])
  @@index([totalPositionsPurchased])
  @@index([resetToken])
}

model Transaction {
  id                 String            @id @default(cuid())
  userId             String
  amountUsd          Float
  positionsPurchased Int
  stripeSessionId    String?           @unique
  timestamp          DateTime          @default(now())
  paymentStatus      TransactionStatus @default(PENDING)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSessionId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  message    String
  readStatus Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readStatus])
}

enum Role {
  USER
  ADMIN
}

enum RankEventType {
  OVERTAKEN
}

model RankEvent {
  id             String        @id @default(cuid())
  climberId      String
  affectedUserId String
  continent      Continent
  climbedToRank  Int
  eventType      RankEventType @default(OVERTAKEN)
  createdAt      DateTime      @default(now())
  climber        User          @relation("RankEventsAsClimber", fields: [climberId], references: [id], onDelete: Cascade)
  affectedUser   User          @relation("RankEventsAsAffected", fields: [affectedUserId], references: [id], onDelete: Cascade)

  @@index([climberId, createdAt])
  @@index([affectedUserId, createdAt])
}

enum Continent {
  AFRICA
  ASIA
  EUROPE
  NORTH_AMERICA
  SOUTH_AMERICA
  OCEANIA
  ANTARCTICA
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}
